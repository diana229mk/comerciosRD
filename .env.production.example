# ComerciosRD — .env.production.example
# Copy to .env on production and fill secret values. DO NOT commit secrets to the repo.

APP_NAME=ComerciosRD
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_YOUR_KEY
APP_DEBUG=false
ECF_ENABLED=false
APP_URL=https://your-production-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance
APP_MAINTENANCE_DRIVER=database
APP_MAINTENANCE_STORE=database

# Sessions and cookies
SESSION_DRIVER=redis
SESSION_LIFETIME=120          # minutes (2h) - adjust to your policy
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_DOMAIN=.your-production-domain.com  # or null if single domain
SESSION_EXPIRE_ON_CLOSE=false

# Security flags (recommended)
SECURITY_2FA_ENABLED=true
SECURITY_2FA_REQUIRED_ROLES=owner,admin
SECURITY_2FA_REQUIRE_MASTER=true
SECURITY_SESSION_FINGERPRINT=true
SECURITY_FINGERPRINT_BIND_IP=false
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_HSTS=true

# Database
DB_CONNECTION=mysql
DB_HOST=<db-host>
DB_PORT=3306
DB_DATABASE=<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

# Cache / Queue / Redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Worker: php artisan queue:work redis --queue=sales,reports,default --tries=3 --timeout=90
# Match these names in the worker; allow at least 120s for supervised shutdown.
SCALE_QUEUE_SALES=sales
SCALE_QUEUE_REPORTS=reports
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=180
SCALE_POST_SALE_QUEUE=true
SCALE_TARGET_CONCURRENT_USERS=10000
SCALE_POS_SEARCH_PER_MINUTE=300
SCALE_POS_CHECKOUT_PER_MINUTE=40
SCALE_SEARCH_DRIVER=mysql
SCALE_DASHBOARD_DAILY_SUMMARY=true
SCALE_METRICS=true
SCALE_METRICS_SLOW_MS=200
AUTH_REQUIRE_BUSINESS_SLUG=false
REDIS_CLIENT=phpredis
REDIS_HOST=<redis-host>
REDIS_PASSWORD=<redis-password>
REDIS_PORT=6379

# Mail (production)
MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS=ventas@your-production-domain.com
MAIL_FROM_NAME="ComerciosRD"

# Filesystem (S3 example)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=<aws-key>
AWS_SECRET_ACCESS_KEY=<aws-secret>
AWS_DEFAULT_REGION=<aws-region>
AWS_BUCKET=<aws-bucket>
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sensitive documents use a separate private disk. Keep local until Spaces
# is provisioned, then set PRIVATE_FILESYSTEM_DRIVER=s3 and configure the
# DO_SPACES_* values below. Never make this bucket public.
PRIVATE_FILESYSTEM_DRIVER=local
# DO_SPACES_KEY=<spaces-key>
# DO_SPACES_SECRET=<spaces-secret>
# DO_SPACES_REGION=<region, e.g. nyc3>
# DO_SPACES_BUCKET=<private-bucket>
# DO_SPACES_ENDPOINT=https://<region>.digitaloceanspaces.com
# DO_SPACES_USE_PATH_STYLE_ENDPOINT=false

# Other
CACHE_PREFIX=comerciosrd_prod
VITE_APP_NAME="${APP_NAME}"

# Portabilidad: backup diario para poder cambiar de proveedor sin perder negocios.
# Conserva el mismo APP_KEY entre proveedores. Nunca restaures sobre la DB en uso.
PORTABILITY_BACKUP_ENABLED=true
PORTABILITY_BACKUP_DIR=/var/backups/comerciosrd
PORTABILITY_BACKUP_KEEP_DAYS=14

# Note about TIME variable found in repo
# If you have TIME=480 (ambiguous), replace it by more explicit variables:
# - SESSION_LIFETIME=120  (minutes)
# - MASTER_SESSION_LIFETIME=480  (minutes) if needed
# Remove generic TIME variable to avoid confusion.

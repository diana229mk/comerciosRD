APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# PRODUCCIÓN: APP_ENV=production y APP_DEBUG=false (nunca true en prod)
APP_DEBUG=true
ECF_ENABLED=false
APP_URL=http://localhost

# ══════════════════════════════════════════════════════════
# BLOQUE PARA PRODUCCIÓN (copiar/adaptar en el .env de prod)
# ══════════════════════════════════════════════════════════
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tudominio.com
#
# SESSION_DRIVER=database        # o redis
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true     # obligatorio con HTTPS
# SESSION_SAME_SITE=lax
# SESSION_HTTP_ONLY=true
# SESSION_DOMAIN=null            # o .tudominio.com si usas subdominios
#
# SECURITY_SESSION_FINGERPRINT=true
# SECURITY_HSTS=true
# SECURITY_CSP_ENABLED=true
#
# ── P3.1 · Hardening HTTP adicional en prod HTTPS ───────
# SECURITY_HSTS_PRELOAD=true      # solo cuando dominio esté listo para
#                                  # inscribirse en hstspreload.org
# SECURITY_CSP_REPORT_ONLY=true   # útil para probar CSP más estricta
#                                  # sin romper Livewire; ver logs y
#                                  # pasar a false cuando esté limpio
#
# ── P3.3 · 2FA obligatorio para roles críticos ──────────
# SECURITY_2FA_ENABLED=true
# SECURITY_2FA_REQUIRED_ROLES=owner,admin
# SECURITY_2FA_REQUIRE_MASTER=true
#
# DB_SEED_MASTER_USERS=false     # NO seedear master admin en prod
#
# Antes de arrancar: `php artisan security:preflight --strict`
# ══════════════════════════════════════════════════════════
#
# ── P3.4 · Deuda técnica documentada ────────────────────
# `users.email` es UNIQUE global (no por negocio). Un mismo empleado
# que trabaja en dos comercios NO puede tener dos cuentas separadas
# con el mismo correo. Cambiarlo requiere:
#   - alter migration: quitar UNIQUE, agregar UNIQUE compuesto en
#     una tabla de identidad por negocio, o mover el login a un
#     handle (business_slug + username).
#   - reescribir Login para requerir contexto de negocio antes de
#     validar credencial.
# NO se implementa en esta fase — se documenta como deuda mayor.
# ══════════════════════════════════════════════════════════

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=comercios_rd
DB_USERNAME=
DB_PASSWORD=
# Tests: nunca uses DB_DATABASE=comercios_rd. PHPUnit fuerza
# comercios_rd_storage_test (ver phpunit.xml y .env.testing).
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# ──────────────────────────────────────────────────────────
# FASE 6 · Variables que DEBEN quedar fijas entre deploys.
# Nunca las regeneres ni las vacíes al redeployar:
#
#   APP_KEY .............. si cambia, TODAS las sesiones y cookies
#                          firmadas quedan inválidas (todos los
#                          usuarios son expulsados). NO rotar.
#
#   SESSION_DRIVER ....... debe ser database o redis en producción.
#                          NUNCA "file" en hosts que recrean el FS
#                          en cada deploy (Docker efímero, PaaS).
#
#   SESSION_DOMAIN ....... un solo dominio → déjalo `null`.
#                          Subdominio por negocio → `.tudominio.com`.
#                          Cambiarlo invalida cookies existentes.
#
#   SESSION_COOKIE ....... nombre de la cookie. NO cambiar en prod
#                          con usuarios logueados (los echa a todos).
#
#   DB_DATABASE / DB_HOST  la tabla `sessions` vive aquí. Si el
#                          deploy apunta a otra DB, los usuarios
#                          logueados pierden sesión.
#
# Al desplegar:
#   php artisan config:cache   ✅ ok
#   php artisan route:cache    ✅ ok
#   php artisan view:cache     ✅ ok
#   php artisan session:flush  ❌ NO — cierra sesión a TODOS.
#   php artisan cache:clear    ⚠️  ok, no toca sesiones.
# ──────────────────────────────────────────────────────────

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Para 100 cajas concurrentes: Redis + PHP-FPM (no artisan serve).
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SCALE_POST_SALE_QUEUE=true

# ── Escala (costuras; no shards) ──────────────────────────────────────
# Worker recomendado: php artisan queue:work --queue=sales,reports,default
SCALE_POST_SALE_QUEUE=false
SCALE_SEARCH_DRIVER=mysql
SCALE_DASHBOARD_DAILY_SUMMARY=true
SCALE_METRICS=true
SCALE_METRICS_SLOW_MS=200
# true = /admin/login exige el slug del negocio (usuario de caja por local)
AUTH_REQUIRE_BUSINESS_SLUG=false
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Seguridad ComerciosRD ──────────────────────────────────
TENANCY_ENFORCE_SCOPE=true
SECURITY_2FA_ENABLED=true
SECURITY_2FA_ISSUER=ComerciosRD
SECURITY_SESSION_FINGERPRINT=true
SECURITY_FINGERPRINT_BIND_IP=false
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_HSTS=true
SECURITY_MASTER_ALLOWED_IPS=
SECURITY_ALERT_MAIL=
SECURITY_ALERT_CHANNEL=stack
SESSION_EXPIRE_ON_CLOSE=true
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# ── Feature flags por negocio (JSON en businesses.features) ────────────
# Se gestionan con: php artisan business:feature <slug> <feature> --enable|--disable
#
# Features disponibles:
#   strict_branch_stock   FASE S3a+ · Fuerza que el POS descuente FEFO sólo
#                         de lotes de la sucursal del cajero, más el fondo
#                         común (lotes sin branch_id). Sin este flag el POS
#                         sigue tomando cualquier lote del negocio.
#                         Requiere: sucursales creadas y usuarios asignados.
#                         Ejemplo:
#                           php artisan business:feature ams strict_branch_stock --enable
#
#   strict_branch_scope   FASE S4a+S4c · Aísla las lecturas por sucursal para
#                         usuarios NO administrativos (cajero, vendedor,
#                         inventario, contable). Filtra ventas, órdenes,
#                         gastos, compras y sesiones de caja al branch_id
#                         del pivot user_business + registros con
#                         branch_id NULL (histórico). Owner/admin/supervisor
#                         siempre ven todo el negocio. Además (S4c) las
#                         policies rechazan update/delete/cancel sobre
#                         registros de otra sucursal aunque se conozca su ID.
#                         Sin este flag no cambia nada.
#                         Ejemplo:
#                           php artisan business:feature ams strict_branch_scope --enable

# ── Portabilidad (cambio de proveedor más adelante) ──
# En producción: true + cron `* * * * * php artisan schedule:run`
PORTABILITY_BACKUP_ENABLED=false
# PORTABILITY_BACKUP_DIR=/var/backups/comerciosrd
PORTABILITY_BACKUP_KEEP_DAYS=14

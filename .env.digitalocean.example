# ComerciosRD — primer nodo en DigitalOcean.
# init-do-env.sh copia este archivo a /etc/comerciosrd/production.env y genera
# APP_KEY y REDIS_PASSWORD. Edita el resto en el servidor. No lo subas a git.

APP_NAME=ComerciosRD
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_YOUR_KEY
APP_DEBUG=false
ECF_ENABLED=false
APP_URL=https://app.tudominio.com
APP_DOMAIN=app.tudominio.com
ACME_EMAIL=ops@tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_DO

# El modo mantenimiento vive en Redis para que todas las réplicas lo vean.
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

COMERCIOS_NODE_ROLE=primary
APP_REPLICAS=1
WORKER_REPLICAS=1
PHP_FPM_MAX_CHILDREN=12

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=false

# * confía en el proxy de esta red Docker (Caddy no está publicado hacia PHP).
# Cuando el TLS pase a un Load Balancer, cambia esto por sus IP privadas.
TRUSTED_PROXIES=*

SECURITY_2FA_ENABLED=true
SECURITY_2FA_REQUIRED_ROLES=owner,admin
SECURITY_2FA_REQUIRE_MASTER=true
SECURITY_SESSION_FINGERPRINT=true
SECURITY_FINGERPRINT_BIND_IP=false
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_HSTS=true

DB_CONNECTION=mysql
DB_HOST=private-db-CHANGEME.db.ondigitalocean.com
DB_PORT=25060
DB_DATABASE=comercios_rd
DB_USERNAME=comercios_app
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_URL=
DB_SOCKET=
MYSQL_SSL_REQUIRED=true
MYSQL_ATTR_SSL_CA=/secrets/mysql-ca.pem

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SCALE_QUEUE_SALES=sales
SCALE_QUEUE_REPORTS=reports
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=180
SCALE_POST_SALE_QUEUE=true
# 200 cabe en el primer Droplet. Subir esto no compra capacidad:
# 1000 avisa que los discos locales no sirven para un segundo servidor;
# 10000 exige Redis, HTTPS y la prueba de docs/scale-readiness-10000.md.
SCALE_TARGET_CONCURRENT_USERS=200
SCALE_POS_SEARCH_PER_MINUTE=300
SCALE_POS_CHECKOUT_PER_MINUTE=40
SCALE_SEARCH_DRIVER=mysql
SCALE_DASHBOARD_DAILY_SUMMARY=true
SCALE_METRICS=true
SCALE_METRICS_SLOW_MS=200
AUTH_REQUIRE_BUSINESS_SLUG=false

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM
REDIS_PORT=6379
REDIS_SCHEME=tcp

MAIL_MAILER=smtp
MAIL_HOST=smtp.tudominio.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USER
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=ventas@tudominio.com
MAIL_FROM_NAME="ComerciosRD"

# Un solo servidor: discos locales del volumen Docker.
# Segundo servidor: PUBLIC_FILESYSTEM_DRIVER=s3, PRIVATE_FILESYSTEM_DRIVER=s3,
# buckets distintos, y PORTABILITY_OBJECT_BACKUP_VERIFIED=true solo después
# de restaurar un objeto de prueba.
FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DRIVER=local
PRIVATE_FILESYSTEM_DRIVER=local
PORTABILITY_OBJECT_BACKUP_VERIFIED=false

CACHE_PREFIX=comerciosrd_prod
PORTABILITY_BACKUP_ENABLED=true
PORTABILITY_BACKUP_DIR=/var/backups/comerciosrd
PORTABILITY_BACKUP_KEEP_DAYS=14
# PORTABILITY_DB_USERNAME/PASSWORD van en /etc/comerciosrd/backup.env (solo el scheduler).
# Las credenciales del migrador van en /etc/comerciosrd/migrator.env (solo migrate).

VITE_APP_NAME="${APP_NAME}"
